<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    package="com.example.sbsoverlay">

    <!-- 基础网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- 前台服务权限（Android 9+ 要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 针对 Android 14+ 的具体前台服务类型权限（此处以 specialUse 为例，请根据实际业务调整） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="SbsOverlay"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- 1. 主入口 Activity 配置 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. 后台服务 Service 配置 -->
        <!-- 增加了 foregroundServiceType 以适配 Android 14+ -->
        <service
            android:name=".SbsService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>

</manifest>
